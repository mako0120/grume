OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

GOOGLE_OAUTH_CLIENT_SECRET_FILE=secrets/google_client_secret.json
GOOGLE_OAUTH_TOKEN_FILE=secrets/google_token.json
GMAIL_QUERY=is:unread has:attachment subject:"[グルメCanva]" -label:grume/done -label:grume/processing
GMAIL_PROCESSING_LABEL=grume/processing
GMAIL_DONE_LABEL=grume/done
GMAIL_ERROR_LABEL=grume/error

# Canva REST: image upload + fallback Autofill
CANVA_API_BASE=https://api.canva.com/rest/v1
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=http://127.0.0.1:8765/callback
CANVA_TOKEN_FILE=secrets/canva_token.json
CANVA_SOURCE_TYPE=design
CANVA_SOURCE_ID=DAHQmZ-GP3I

# Preferred mode: exact editing through Canva MCP
# off | autofill | mcp
CANVA_MODE=mcp
CANVA_MCP_SERVER_URL=https://mcp.canva.com/mcp
CANVA_MCP_CLIENT_ID=
CANVA_MCP_CLIENT_SECRET=
CANVA_MCP_REDIRECT_URI=http://127.0.0.1:8766/callback
CANVA_MCP_TOKEN_FILE=secrets/canva_mcp_token.json
CANVA_TEMPLATE_PROFILE=config/canva_template_profile.yaml

OUTPUT_DIR=output
DEFAULT_AREA=大阪
MIN_IMAGES=1
MAX_IMAGES=20
POLL_INTERVAL_SECONDS=60
LOG_LEVEL=INFO
